# ==========================================
# GLOBALS (Geral para o ambiente de dev)
# ==========================================
.vscode/
.idea/
.DS_Store
thumbs.db
*.log
error-logs.txt

# ==========================================
# BACKEND (Node.js + Prisma)
# ==========================================
# Ignora as dependências do Node na API
**/api/node_modules/

# Ignora o arquivo de variáveis de ambiente (onde fica a senha do banco)
**/api/.env
**/api/.env.local
**/api/.env.development

# Ignora arquivos gerados pelo Prisma (se houver arquivos de banco locais como SQLite)
**/api/prisma/*.db
**/api/prisma/*.db-journal

# Ignora a pasta de build do Node (se você usa TypeScript/NestJS/Express com build)
**/api/dist/
**/api/build/

# ==========================================
# FRONTEND (Angular)
# ==========================================
# Ignora as dependências do Node no Front
**/front/node_modules/

# Ignora os arquivos de cache e build do Angular
**/front/.angular/
**/front/dist/

# Ignora configurações locais do Angular se houver
**/front/.env