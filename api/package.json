{
  "name": "clinica-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "prisma:build": "prisma-import ./prisma/schema.prisma > ./prisma/schema-build.prisma",
    "prisma:generate": "npm run prisma:build && prisma generate --schema ./prisma/schema-build.prisma",
    "prisma:migrate": "npm run prisma:build && prisma migrate dev --schema ./prisma/schema-build.prisma"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "prisma": "^6.19.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@types/node": "^25.8.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma-import": "^1.0.5",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  }
}
